# Copia este archivo a .env (docker compose lo lee automáticamente).
# Solo valores de desarrollo; nunca subas secretos reales.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
BASE_DOMAIN=localhost

# Verificación en dos pasos (2FA). 0 = apagada, solo para probar en desarrollo sin autenticador.
# REACTIVAR (quitar esta línea o poner 1) ANTES DE ENTREGAR. Producción no arranca con ella en 0.
REQUIRE_TWO_FACTOR=0

# Superusuario de PostgreSQL: solo lo usa el contenedor para inicializar la base.
POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Rol de la aplicación (sin superusuario, para que RLS se aplique). Django usa este.
APP_DB_USER=agenda_app
APP_DB_PASSWORD=agenda_app

REDIS_URL=redis://redis:6379/0

# Puerto del host donde Caddy publica la app (http://localhost:8080)
HTTP_PORT=8080
HTTPS_PORT=8443
# Dirección que sirve Caddy. En local: http://localhost. En prod: tu dominio.
CADDY_SITE_ADDRESS=:80

# Reserva pública (M6)
PUBLIC_BOOKING_LIMIT_PER_IP=10
PUBLIC_BOOKING_LIMIT_PER_PHONE=5
# Proxies propios delante de Django (Caddy = 1). La IP del cliente sale de X-Forwarded-For.
TRUSTED_PROXY_COUNT=1
# Captcha opcional (Turnstile, hCaptcha o reCAPTCHA)
PUBLIC_BOOKING_CAPTCHA=0
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_SECRET=

# Notificaciones (M8). En desarrollo WhatsApp usa FakeProvider (no envía nada).
# WHATSAPP_PROVIDER=apps.notifications.providers.CloudApiProvider
WHATSAPP_PROVIDER=apps.notifications.providers.FakeProvider
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
NOTIFICATION_REMINDER_HOURS=24,2
# Enlace de la cita en los mensajes. En local incluye el puerto de Caddy.
PUBLIC_SITE_URL=http://{host}:8080

